# Which Gemma 4 host to use: gemini | vertex | openai
GEMMA_PROVIDER=gemini
# gemini: Gemini API key from https://aistudio.google.com/apikey (serves gemma-4-26b-a4b-it)
GEMINI_API_KEY=
# vertex: Google Cloud project with the Vertex AI (Agent Platform) API enabled; auth via Application Default Credentials
VERTEX_PROJECT=
VERTEX_LOCATION=global
# openai: any OpenAI-compatible host serving Gemma 4 (e.g. OpenRouter)
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Optional overrides
GEMMA_MODEL=
LLM_WORKERS=24
